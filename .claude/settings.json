{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(mypy *)",
      "Bash(ruff check *)",
      "Bash(nvidia-smi --query-gpu=*)",
      "Bash(curl -s http://localhost:11434/api/tags)",
      "Bash(curl -s http://localhost:11434/api/ps)",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint_edited.py\"",
            "timeout": 120,
            "statusMessage": "Checking edited file (ruff + mypy)..."
          }
        ]
      }
    ]
  }
}
