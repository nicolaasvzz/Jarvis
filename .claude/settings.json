{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/lint_edited.py\"",
            "timeout": 120,
            "statusMessage": "Checking edited file (ruff + mypy)..."
          }
        ]
      }
    ]
  }
}
