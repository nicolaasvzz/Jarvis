# Copy to .env (gitignored) and fill in your own values. Never commit the real file.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Leave unset to use Alpaca's paper endpoint. Only set this to the live URL
# once you've deliberately decided to trade real money.
# ALPACA_BASE_URL=https://api.alpaca.markets

# Research (investment-bot research): Gemini scores the news. Same kind of key
# as Jarvis's; free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: posts on X. Pay-per-use; the bot never spends more than
# research.x.monthly_cap (config) a month. Leave empty to keep X off.
X_BEARER_TOKEN=
