# JARVIS settings. jarvis.py copies this to .env on first run; fill in the
# Gemini key and start it again. .env is never committed to git.

# Required: a FREE key from https://aistudio.google.com/apikey
# (sign in with a Google account, click "Create API key", paste it here).
GEMINI_API_KEY=

# The model. Flash-Lite is the fastest and is on the free tier;
# gemini-3.8-flash is smarter but slower.
GEMINI_MODEL=gemini-3.5-flash-lite
# How much the model reasons before answering: minimal, low, medium, high.
# Blank = the model's own default (fastest on Flash-Lite).
GEMINI_THINKING=

# The dashboard's password. Leave blank: jarvis.py makes one and saves it here.
JARVIS_API_TOKEN=

# Where weather questions default to when you don't say, e.g. Cape Town.
HOME_LOCATION=

# Terminal commands wait for Allow/Deny on the dashboard. true = run them
# without asking (only if you trust every command Gemini might write).
AUTO_APPROVE=false
# Read-only commands (git status, dir, --version, ...) run without asking.
# false = ask for those too.
ALLOW_SAFE_COMMANDS=true
# When a terminal command you or Jarvis started runs at least this many
# seconds, Jarvis tells you how it went once it finishes. 0 = never.
NOTIFY_AFTER_SECONDS=20
# Terminals to open (and commands to run in them) when Jarvis starts — copy
# terminals.example.json to terminals.json and edit it.
STARTUP_TERMINALS=terminals.json

# The folder commands and terminals start in.
JARVIS_WORKSPACE=workspace

# Jarvis's voice. off = silent. Otherwise the Edge voice name used when
# JARVIS_VOICE_PROVIDER=edge (free; needs: pip install edge-tts).
JARVIS_VOICE=en-GB-RyanNeural
# Who speaks: openai (ChatGPT's voices - much more natural,
# paid per use). openai without a key falls back to edge.
JARVIS_VOICE_PROVIDER=openai

# OpenAI (ChatGPT) voice. Key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-4o-mini-tts is the natural one; tts-1 / tts-1-hd are older and cheaper.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
# (onyx / ash / fable suit a British butler).
OPENAI_TTS_VOICE=onyx
# How the OpenAI voice should sound (gpt-4o-mini-tts only). Blank = a deep,
# refined British butler. Describe accent, pace and mood in plain words.
JARVIS_VOICE_STYLE=

# Microphone (speech to text):
#   browser = the browser's own speech recognition. Free, no key, works in
#             Chrome and Edge (not Firefox or the Claude app's built-in browser).
#   whisper = Whisper running on this computer (pip install faster-whisper).
#             Free, private, any browser; a second or two per sentence.
#   wispr   = Wispr Flow. Its API is by approval: https://platform.wisprflow.ai
#   off     = type only.
JARVIS_LISTEN_PROVIDER=browser
# What you speak, for the browser option (BCP 47, e.g. en-GB, en-US, af-ZA).
JARVIS_LISTEN_LANGUAGE=en-GB
# Whisper only: small.en is accurate for English; base.en is faster, medium.en
# is better still but slower.
WHISPER_MODEL=small.en
# Wispr Flow only:
WISPR_API_KEY=
# Language hint for what you speak (ISO 639-1, e.g. en, af, de).
WISPR_LANGUAGE=en

# Which Google News edition get_news reads.
NEWS_COUNTRY=US
NEWS_LANGUAGE=en

# Where the dashboard listens. 0.0.0.0 = reachable from other devices on
# your network (they still need the token).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Other web pages allowed to use the API (comma-separated); localhost is
# always allowed.
JARVIS_CORS_ORIGINS=
# Open the dashboard in your browser on start.
JARVIS_OPEN_BROWSER=true
