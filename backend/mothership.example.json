    {
      "id": "c-bot-champ",
      "name": "Champ-set builder",
      "group": "TradeBot",
      "project": "p-tradebot",
      "kind": "command",
      "action": ".\\run-local.ps1 -Mode champ -For {limit} -Round {round} -Style {style} -Confidence {confidence} -Bet {bet} -Custom {custom} -Money {money} -Research {research}",
      "description": "Keeps improving the champion set of indicators - adding, swapping and re-weighting them, kept only when it beats the champion on training and held-out data - until every indicator has been tried in the set. Then it stops by itself and writes a report. Stop any time: it carries on where it left off.",
      "trusted": false,
      "inputs": [
        {
          "name": "limit",
          "label": "Give up after at most",
          "kind": "choice",
          "default": "3d",
