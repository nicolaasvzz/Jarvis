    {
      "id": "c-bot-learn",
      "name": "Learning mode",
      "group": "TradeBot",
      "project": "p-tradebot",
      "kind": "command",
      "action": ".\\run-local.ps1 -Mode {how} -For {duration} -Round {round} -Style {style} -Confidence {confidence} -Bet {bet} -Custom {custom} -Money {money} -Research {research}",
      "description": "Teaches the strategy settings from backtests. A learning session backtests over and over for the time you pick, keeping a setting change only if it holds up on held-out data; one backtest takes about 3 minutes. Pick a strategy to try - it becomes the current one and the rest is refined around it; custom words also steer the session (shorts, a symbol, win rate). Either way it writes a report.",
      "trusted": false,
      "inputs": [
