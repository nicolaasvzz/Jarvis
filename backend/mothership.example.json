    {
      "id": "c-bot-update",
      "name": "Update Jarvis and the bot",
      "group": "TradeBot",
      "project": "p-tradebot",
      "kind": "command",
      "action": "git pull --ff-only; if ($? -and (Test-Path .venv)) { .\\.venv\\Scripts\\python -m pip install -q -r requirements.txt; .\\.venv\\Scripts\\python -m investment_bot status -c config.local.yaml }",
      "description": "Pull the latest Jarvis and TradeBot from GitHub and reinstall the bot's dependencies. Then restart Jarvis (and press Restart on a running mode) so they use the new code.",
      "trusted": false,
      "pinned": true
    },
