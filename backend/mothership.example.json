  "projects": [
    {
      "id": "p-tradebot",
      "name": "TradeBot",
      "description": "The trading bot that comes with Jarvis (the tradebot folder): Alpaca paper money by default. It builds and tests its own indicator sets, learns from every backtest, and can watch the news. Its live status comes from jarvis_status.json. Put your Alpaca keys in tradebot/.env first (see tradebot/.env.example).",
      "folder": "tradebot",
      "status_file": "jarvis_status.json",
      "hue": 150,
      "links": [
        {
          "label": "Bot API (when running with -Mode api)",
          "url": "http://127.0.0.1:8000/docs"
        }
      ],
      "ideas": [],
      "controls_title": "Modes",
      "reports_dir": "reports"
    }
  ]
