# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never commit these. Unanchored, so they match in backend/ and
# anywhere else a copy ends up.
.env
.env.*
!.env.example

# Local (machine-specific) configuration; commit config.example.yaml instead.
# "**/" because a pattern containing a slash is otherwise anchored to the repo
# root, and the real file lives in backend/config/.
**/config/config.yaml

# Logs
*.log
*.jsonl

# The file-manager sandbox: whatever Jarvis is actually working on. These are
# the user's own documents, not source — and this repo has a public remote.
Workspace/
workspace/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
