# Jarvis secrets — copy to .env (gitignored) and fill in real values.
# Secrets are ONLY read from the environment or this file, never from
# config.yaml, so they can't be committed by accident.

# Anthropic API key used by the Brain module.
ANTHROPIC_API_KEY=

# Shared token the phone client must present to the Jarvis API server.
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_API_TOKEN=

# Telegram bot token for phone control + push (from @BotFather in Telegram).
# Needed only if telegram.enabled is true. This is the recommended way to
# control Jarvis from your phone — it needs no wifi/LAN, only outbound internet.
TELEGRAM_BOT_TOKEN=

# Optional: auth token for a protected ntfy push server. Public ntfy.sh
# topics need none, so leave blank unless you self-host ntfy with auth.
JARVIS_PUSH_TOKEN=
